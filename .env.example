# Copy to .env.local and fill in. .env.local is gitignored — never commit it.
# The same values go in the Vercel dashboard.

NEXT_PUBLIC_SUPABASE_URL=https://cidxctilamdxbzjjzppb.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix with NEXT_PUBLIC_. This key bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Public — it is the first path segment of every image URL. lib/media/cloud.ts
# carries this same value as a default (decision 052); set it here only to
# point a local build at a different cloud.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=vewhrkzj

# Sync script only.
NOTION_API_KEY=

# Shared secret for POST /api/revalidate.
REVALIDATE_SECRET=

NEXT_PUBLIC_GA_ID=

# ── Operator notification on contact and CV submissions (decision 051) ──────
# Resend, called with fetch — no SDK, nothing in package.json.
#
# Server-only. NEVER prefix any of these with NEXT_PUBLIC_.
#
# The message is stored either way; these only control whether Moataz is told.
# All three unset is a supported state: the insert still happens, the visitor
# still sees success, and the row records `notify_error: not configured`.
#
# Until a domain is verified, Resend sends ONLY from onboarding@resend.dev and
# ONLY to the address the account was created with — so CONTACT_NOTIFY_TO must
# be that address. After the domain is verified, change CONTACT_NOTIFY_FROM to
# an address on it; no code changes.
RESEND_API_KEY=
CONTACT_NOTIFY_TO=
CONTACT_NOTIFY_FROM=onboarding@resend.dev
